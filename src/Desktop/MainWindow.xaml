<Window x:Class="DesktopAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面助手" Width="1180" Height="760" MinWidth="780" MinHeight="560"
        Background="{StaticResource Workspace}" Foreground="{StaticResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Language="zh-CN" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid TextElement.Foreground="{StaticResource Ink}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,22,0" VerticalAlignment="Center">
                    <Grid Width="36" Height="36" IsHitTestVisible="False">
                        <Path Fill="#193646" Stroke="{StaticResource Accent}" StrokeThickness="1"
                              Data="M 1,8 L 8,1 H 35 V 28 L 28,35 H 1 Z"/>
                        <Path Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M 9,21 H 13 L 17,11 20,25 23,17 H 28"/>
                    </Grid>
                    <TextBlock Style="{StaticResource LabelText}" x:Name="BrandName" Margin="11,0,0,0" VerticalAlignment="Center" MaxWidth="166"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="18"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavChat" Style="{StaticResource Nav}" Tag="0" Click="Navigate" Content="对话"/>
                    <Button x:Name="NavSchedule" Style="{StaticResource Nav}" Tag="1" Click="Navigate" Content="日程"/>
                    <Button x:Name="NavHistory" Style="{StaticResource Nav}" Tag="2" Click="Navigate" Content="历史"/>
                    <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="3" Click="Navigate" Content="设置"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <Button x:Name="PauseButton" DockPanel.Dock="Right" Click="PauseMic" Content="暂停麦克风"
                        Margin="14,0,0,0" Padding="10,4" MinHeight="30" FontSize="12"/>
                <Ellipse x:Name="MicIndicator" DockPanel.Dock="Left" Width="7" Height="7"
                         Fill="{StaticResource Muting}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="MicState" Style="{StaticResource Muted}" FontSize="12" Text="麦克风待命"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate>
            </TabControl.Template>
            <TabItem Header="对话">
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Background="{StaticResource InstrumentBody}" Padding="13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Heading}" Text="语音控制"/>
                                <Viewbox Grid.Row="1" Width="208" MaxHeight="198" Margin="0,3" IsHitTestVisible="False">
                                    <Grid Width="208" Height="188">
                                        <Rectangle Fill="{StaticResource InstrumentGrid}" Opacity=".59" Margin="0,6"/>
                                        <Path Stroke="#40627D" StrokeThickness="1" Data="M 10,40 V 25 H 32 M 176,25 H 198 V 40 M 10,148 V 163 H 32 M 176,163 H 198 V 148"/>
                                        <Path Stroke="#324A62" StrokeThickness="1" Data="M 104,7 V 29 M 104,159 V 181 M 10,94 H 37 M 171,94 H 198 M 43,41 L 54,49 M 165,147 L 154,139 M 165,41 L 154,49 M 43,147 L 54,139"/>
                                        <Path Fill="#0F1D2C" Stroke="#476986" StrokeThickness="1.3"
                                              Data="M 77,39 H 131 L 159,65 V 123 L 131,149 H 77 L 49,123 V 65 Z"/>
                                        <Path Stroke="#213A52" StrokeThickness="6"
                                              Data="M 79,47 H 129 L 151,69 V 119 L 129,141 H 79 L 57,119 V 69 Z"/>
                                        <Path Stroke="#679CB6" StrokeThickness="1.2"
                                              Data="M 48,74 V 65 L 76,39 H 98 M 110,149 H 132 L 160,123 V 114"/>
                                        <Path Stroke="#294662" StrokeThickness="1"
                                              Data="M 67,75 L 84,58 H 124 L 141,75 V 113 L 124,130 H 84 L 67,113 Z"/>
                                        <Path Stroke="#526F8C" StrokeThickness="1"
                                              Data="M 80,61 H 128 M 80,127 H 128 M 61,80 V 107 M 147,80 V 107"/>
                                        <Path x:Name="CoreSignal" Stroke="{StaticResource Accent}" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 77,91 V 97 M 86,85 V 103 M 95,80 V 108 M 104,73 V 115 M 113,83 V 105 M 122,86 V 102 M 131,91 V 97"/>
                                        <Path x:Name="CoreMarkers" Fill="{StaticResource Accent}"
                                              Data="M 99,39 H 109 V 41 H 99 Z M 99,147 H 109 V 149 H 99 Z M 34,92 H 39 V 96 H 34 Z M 169,92 H 174 V 96 H 169 Z"/>
                                    </Grid>
                                </Viewbox>
                                <Button x:Name="TalkButton" Grid.Row="2" Click="Talk" Content="说话"
                                        Style="{StaticResource Primary}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="模型连接"/>
                                <TextBlock x:Name="ProviderState" Style="{StaticResource Muted}" Margin="0,6,0,10"
                                           FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="ConnectButton" Click="OpenSettings" Content="配置模型"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}"
                                    BorderThickness="0,0,0,1" CornerRadius="5,5,0,0">
                                <DockPanel Margin="16,11">
                                    <Button DockPanel.Dock="Right" Click="NewChat" Content="新会话" VerticalAlignment="Center"/>
                                    <Button x:Name="ChatUsageButton" DockPanel.Dock="Right" Click="OpenPlanUsage" Content="管理用量"
                                            Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource Heading}" Text="对话" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="Welcome" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                                <Border Width="32" Height="2" HorizontalAlignment="Center" Background="{StaticResource Accent}" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Heading}" HorizontalAlignment="Center" FontSize="22" Text="有什么需要帮忙？"/>
                                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"
                                           Text="输入消息，或点击「说话」开始录音。"/>
                            </StackPanel>
                            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
                                <StackPanel x:Name="ChatMessages"/>
                            </ScrollViewer>
                            <Border x:Name="DraftCard" Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource Raised}"
                                    Visibility="Collapsed" Margin="12,0,12,8" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Click="OpenDraft" Content="核对日程"/>
                                    <TextBlock Style="{StaticResource LabelText}" x:Name="DraftLabel" VerticalAlignment="Center" Margin="4,0,8,0"
                                               TextTrimming="CharacterEllipsis" MaxHeight="42"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}"
                                    BorderThickness="0,1,0,0" Padding="12,9,12,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button x:Name="StopButton" Click="StopReply" Content="停止" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <Button x:Name="SendButton" Click="Send" Content="发送" Style="{StaticResource Primary}"/>
                                    </StackPanel>
                                    <Grid>
                                        <TextBox x:Name="Composer" AutomationProperties.Name="输入消息" TextWrapping="Wrap" AcceptsReturn="True"
                                                 MaxHeight="95" MaxLength="12000" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ComposerKey"/>
                                        <TextBlock Text="输入消息" Margin="10,7,0,0" IsHitTestVisible="False" Focusable="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=Composer}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="4" Background="{StaticResource Sidebar}" CornerRadius="0,0,5,5" Padding="12,5,12,8">
                                <TextBlock x:Name="ChatStatus" Style="{StaticResource Muted}" FontSize="12" MinHeight="18" MaxHeight="54"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="日程">
                <Grid Margin="27,22,27,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <DatePicker x:Name="ScheduleDay" AutomationProperties.Name="选择日期" Width="162"
                                        SelectedDateChanged="ScheduleDateChanged"/>
                            <Button Content="今天" Click="Today" Margin="6,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="日程"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Click="NewAppointment" Content="新增"/>
                                    <TextBlock Style="{StaticResource Heading}" Text="当天安排" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="ScheduleEmpty" DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="这一天还没有安排。" Margin="0,0,0,7"/>
                                <ListBox x:Name="ScheduleList" AutomationProperties.Name="日程列表" SelectionChanged="AppointmentSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,7">
                                                <TextBlock Style="{StaticResource LabelText}" Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Timing}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="AppointmentHeading" Style="{StaticResource Heading}" Text="新日程"/>
                                    <TextBlock Style="{StaticResource LabelText}" Text="日期" Margin="0,12,0,4"/>
                                    <DatePicker x:Name="EditDay" AutomationProperties.Name="日程日期"/>
                                    <TextBlock Style="{StaticResource LabelText}" Text="标题" Margin="0,10,0,4"/>
                                    <TextBox x:Name="EditTitle" AutomationProperties.Name="日程标题" MaxLength="200"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{StaticResource LabelText}" Text="开始时间" Margin="0,0,0,4"/><TextBox x:Name="EditStart" AutomationProperties.Name="开始时间" MaxLength="5"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource LabelText}" Text="结束时间（可选）" Margin="0,0,0,4"/><TextBox x:Name="EditEnd" AutomationProperties.Name="结束时间" MaxLength="5"/></StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource LabelText}" Text="备注" Margin="0,10,0,4"/>
                                    <TextBox x:Name="EditNote" AutomationProperties.Name="日程备注" AcceptsReturn="True"
                                             TextWrapping="Wrap" Height="66" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
                                    <CheckBox x:Name="EditDone" Content="已完成"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <Button Click="SaveAppointment" Style="{StaticResource Primary}" Content="保存日程"/>
                                        <Button x:Name="DeleteAppointmentButton" Click="DeleteAppointment" Content="删除" Margin="7,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ScheduleStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="历史">
                <Grid Margin="27,22,27,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <TextBox x:Name="HistorySearch" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" MaxLength="200"
                                 AutomationProperties.Name="搜索标题或消息" ToolTip="搜索标题或消息" TextChanged="SearchHistory"/>
                        <TextBlock Style="{StaticResource PageTitle}" Text="历史记录"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="7">
                            <ListBox x:Name="HistoryList" SelectionChanged="HistorySelected" AutomationProperties.Name="历史会话">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,7">
                                            <TextBlock Style="{StaticResource LabelText}" Text="{Binding Title}" FontWeight="SemiBold" MaxWidth="197"/>
                                            <TextBlock Text="{Binding Updated}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="2">
                            <DockPanel>
                                <TextBlock x:Name="HistoryHeading" Style="{StaticResource Heading}" Text="选择一条会话" DockPanel.Dock="Top"/>
                                <WrapPanel x:Name="HistoryActions" DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="False">
                                    <Button Click="ResumeConversation" Content="继续对话" Margin="0,0,6,4"/>
                                    <Button Click="ExportHistory" Content="导出" Margin="0,0,6,4"/>
                                    <Button Click="DeleteHistory" Content="删除" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel x:Name="HistoryMessages"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="27,22,27,20" MaxWidth="980">
                        <TextBlock Style="{StaticResource PageTitle}" Text="设置" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="模型连接"/>
                                <ComboBox x:Name="ModelMode" AutomationProperties.Name="模型接入方式"
                                          SelectionChanged="ModelModeChanged" Margin="0,8,0,0">
                                    <ComboBoxItem Content="ChatGPT 订阅"/>
                                    <ComboBoxItem Content="API Key / 本机 Ollama"/>
                                </ComboBox>
                                <TextBlock x:Name="ActiveModelText" Style="{StaticResource Muted}" Margin="0,6,0,4"/>
                                <StackPanel x:Name="PlanModelPanel">
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" x:Name="UsageButton" Content="查看 ChatGPT 用量"
                                                Click="OpenPlanUsage" Margin="8,0,0,0"/>
                                        <TextBlock Style="{StaticResource LabelText}" Text="ChatGPT 账号" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ComboBox x:Name="PlanAccounts" AutomationProperties.Name="ChatGPT 账号"
                                              SelectionChanged="PlanAccountChanged" DisplayMemberPath="Label" Margin="0,4,0,0"
                                              SelectedValuePath="Id"/>
                                    <TextBlock x:Name="PlanAccountState" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button x:Name="PlanSignInButton" Click="SignInPlan" Content="Continue with ChatGPT" Margin="0,0,7,4"/>
                                        <Button x:Name="PlanAddButton" Click="AddPlanAccount" Content="添加其他账号" Margin="0,0,7,4"/>
                                        <Button x:Name="PlanSignOutButton" Click="SignOutPlan" Content="退出所选账号" Margin="0,0,7,4"/>
                                        <Button x:Name="PlanCancelButton" Click="CancelPlanOperation" Content="取消" Visibility="Collapsed" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <StackPanel x:Name="PlanLoginPanel" Visibility="Collapsed" Margin="0,6,0,9">
                                        <TextBlock Style="{StaticResource Muted}" Text="请在浏览器完成授权。如果浏览器回调失败，可粘贴地址栏中的完整回调地址。"/>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Click="SubmitPlanCallback" Content="提交回调" Margin="8,0,0,0"/>
                                            <PasswordBox x:Name="PlanCallback" AutomationProperties.Name="ChatGPT 登录回调地址" MaxLength="8192"/>
                                        </DockPanel>
                                        <Button Click="ReopenPlanBrowser" Content="重新打开授权页面" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="订阅模型" Margin="0,8,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="PlanRefreshButton" Click="RefreshPlanModels"
                                                Content="刷新列表" Margin="8,0,0,0"/>
                                        <ComboBox x:Name="PlanModels" AutomationProperties.Name="ChatGPT 订阅模型" DisplayMemberPath="Label"
                                                  SelectedValuePath="Id" SelectionChanged="PlanModelChanged"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="PlanTestButton" Click="TestPlanModel" Content="测试订阅模型" Margin="0,0,7,4"/>
                                        <Button x:Name="PlanSaveButton" Click="SavePlanModel" Content="使用该模型"
                                                Style="{StaticResource Primary}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="PlanStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ApiModelPanel">
                                <TextBlock Style="{StaticResource LabelText}" Text="服务地址" Margin="0,8,0,3"/>
                                <TextBox x:Name="Endpoint" AutomationProperties.Name="模型服务地址" MaxLength="1024"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"
                                           Text="OpenAI 兼容接口的基础地址，例如 http://127.0.0.1:11434/v1。"/>
                                <TextBlock Style="{StaticResource LabelText}" Text="模型名称" Margin="0,8,0,3"/>
                                <TextBox x:Name="ModelName" AutomationProperties.Name="模型名称" MaxLength="200"/>
                                <TextBlock Style="{StaticResource LabelText}" Text="API 密钥（可选）" Margin="0,8,0,3"/>
                                <PasswordBox x:Name="ApiKey" AutomationProperties.Name="API 密钥" MaxLength="1200"/>
                                <WrapPanel Margin="0,11,0,0">
                                    <Button x:Name="TestProviderButton" Click="TestProvider" Content="测试连接" Margin="0,0,7,4"/>
                                    <Button Click="SaveProvider" Content="保存模型" Style="{StaticResource Primary}" Margin="0,0,7,4"/>
                                    <Button Click="ClearKey" Content="清除密钥" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="ProviderStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="应用更新"/>
                                <TextBlock x:Name="UpdateVersion" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="CheckUpdateButton" Click="CheckUpdates" Content="检查更新" Margin="0,0,7,4"/>
                                    <Button x:Name="InstallUpdateButton" Click="InstallUpdate" Content="下载并重启"
                                            Style="{StaticResource Primary}" Margin="0,0,7,4"/>
                                    <Button x:Name="CancelUpdateButton" Click="CancelUpdate" Content="取消" Visibility="Collapsed" Margin="0,0,7,4"/>
                                    <Button x:Name="OpenReleasesButton" Click="OpenReleases" Content="打开发布页" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="显示名称"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="保存名称" Click="SaveName" Margin="8,0,0,0"/>
                                    <TextBox x:Name="DisplayName" AutomationProperties.Name="显示名称" MaxLength="32"/>
                                </DockPanel>
                                <TextBlock x:Name="NameStatus" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="声音与唤醒"/>
                                <TextBlock Style="{StaticResource LabelText}" Text="唤醒词" Margin="0,8,0,3"/>
                                <TextBox x:Name="Keyword" AutomationProperties.Name="唤醒词" MaxLength="48"/>
                                <TextBlock Style="{StaticResource LabelText}" Text="唤醒语言" Margin="0,8,0,3"/>
                                <ComboBox x:Name="WakeLanguage" AutomationProperties.Name="唤醒语言"/>
                                <TextBlock Style="{StaticResource LabelText}" Text="朗读音色" Margin="0,8,0,3"/>
                                <ComboBox x:Name="Speaker" AutomationProperties.Name="朗读音色"/>
                                <CheckBox x:Name="AlwaysListen" Content="开启后台唤醒"/>
                                <CheckBox x:Name="SpeakReplies" Content="朗读模型回复"/>
                                <CheckBox x:Name="ListenWhileSpeaking" Content="使用外部回声消除时，播报期间保持唤醒"/>
                                <WrapPanel Margin="0,11,0,0">
                                    <Button Click="TryWake" Content="试读唤醒词" Margin="0,0,7,4"/>
                                    <Button Click="TryVoice" Content="试听音色" Margin="0,0,7,4"/>
                                    <Button Click="SaveVoice" Content="保存语音设置" Style="{StaticResource Primary}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="VoiceStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Click="AddPlugin" Content="加载插件清单"/>
                                    <TextBlock Style="{StaticResource Heading}" Text="语音引擎" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="PluginRows" Margin="0,4,0,0"/>
                                <TextBlock x:Name="PluginStatus" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
